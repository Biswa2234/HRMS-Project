generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}




model Role {
  id          Int     @id @default(autoincrement()) @db.UnsignedInt
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  roleId Int @db.UnsignedInt

  firstName String  @db.VarChar(100)
  lastName  String? @db.VarChar(100)

  email    String @unique @db.VarChar(255)
  username String @unique @db.VarChar(100)

  passwordHash String @db.VarChar(255)

  avatarUrl String? @db.VarChar(500)
  phone     String? @db.VarChar(30)

  isActive Boolean @default(true)

  lastLoginAt DateTime?

  role            Role            @relation(fields: [roleId], references: [id])
  createdProjects Project[]
  projectMembers  ProjectMember[]

  assignedTasks Task[] @relation("AssignedTasks")

  taskComments    TaskComment[]
  taskAttachments TaskAttachment[]

  leaveRequests  LeaveRequest[] @relation("UserLeaveRequests")
  reviewedLeaves LeaveRequest[] @relation("ReviewedLeaveRequests")

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name        String  @db.VarChar(150)
  description String? @db.Text

  startDate DateTime?
  endDate   DateTime?
  status    String    @default("active") @db.VarChar(50)

  createdById BigInt @db.UnsignedBigInt

  createdBy User            @relation(fields: [createdById], references: [id])
  members   ProjectMember[]
  tasks     Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  projectId BigInt @db.UnsignedBigInt
  userId    BigInt @db.UnsignedBigInt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Task {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  projectId    BigInt  @db.UnsignedBigInt
  assignedToId BigInt? @db.UnsignedBigInt

  title       String  @db.VarChar(200)
  description String? @db.Text

  status   String @default("todo") @db.VarChar(50)
  priority String @default("medium") @db.VarChar(50)

  dueDate DateTime?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  comments    TaskComment[]
  attachments TaskAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskComment {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  taskId BigInt @db.UnsignedBigInt
  userId BigInt @db.UnsignedBigInt

  comment String @db.Text

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskAttachment {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  taskId       BigInt @db.UnsignedBigInt
  uploadedById BigInt @db.UnsignedBigInt

  fileName String  @db.VarChar(255)
  fileUrl  String  @db.VarChar(500)
  fileType String? @db.VarChar(100)
  fileSize BigInt?

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model LeaveRequest {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  userId BigInt @db.UnsignedBigInt

  leaveType String   @db.VarChar(50)
  startDate DateTime
  endDate   DateTime
  reason    String?  @db.Text

  status String @default("pending") @db.VarChar(50)

  reviewedById BigInt?   @db.UnsignedBigInt
  reviewedAt   DateTime?

  user       User  @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewedLeaveRequests", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  senderId   BigInt @db.UnsignedBigInt
  receiverId BigInt @db.UnsignedBigInt

  subject String? @db.VarChar(255)
  content String  @db.Text

  isRead Boolean   @default(false)
  readAt DateTime?

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model RefreshToken {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  userId BigInt @db.UnsignedBigInt

  token     String    @unique @db.VarChar(500)
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model AuditLog {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  userId BigInt? @db.UnsignedBigInt

  action    String  @db.VarChar(100)
  entity    String  @db.VarChar(100)
  entityId  BigInt?
  oldValue  Json?
  newValue  Json?
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}
